# Public site URL (Open Graph and absolute links).
# On Vercel it can stay empty: the production domain (VERCEL_PROJECT_PRODUCTION_URL) is used.
NEXT_PUBLIC_SITE_URL=

# IberaReclamos backend (POST /api/feedback). Empty = demo mode: the "Valorar" form sends nothing.
NEXT_PUBLIC_API_URL=

# Map tiles (public). Empty = Esri World Imagery fallback (fine for the hackathon, MapTiler recommended for production).
NEXT_PUBLIC_MAPTILER_KEY=

# Backend for the rangers module (/rangers). Next forwards /api/* to it at build time.
# Empty = uses NEXT_PUBLIC_API_URL.
API_URL=
